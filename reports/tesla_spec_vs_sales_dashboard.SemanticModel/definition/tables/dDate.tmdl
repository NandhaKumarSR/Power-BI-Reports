	partition dDate = calculated
		mode: import
		source =
				ADDCOLUMNS(
				    CALENDAR(DATE(2016,01,01),DATE(2026,12,31)),
				    "Year",YEAR([Date]),
				    "Qtr","Q" & QUARTER([Date]),
				    "Year & Qtr", YEAR([Date]) & " Q" & QUARTER([Date])
				)

	annotation PBI_Id = 25354936217e4220b005b2fbc20e43f3

