	measure 'Weighted sales Value' =
			
			SUMX(dModels,CALCULATE(SUM(dModels[Starting Prices])) * CALCULATE(SUM(fUnitsSold[Value])))
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: cb4d1e6b-271f-4190-bfad-e797fc00d00f

	measure Donut = ```
			
			VAR Donut_Fill = (CALCULATE(sum(fUnitsSold[Value]))/CALCULATE(SUM(fUnitsSold[Value]),ALL(dModels[Model])))*100
			VAR Donut_Text = FORMAT(Donut_Fill/100,"#.0%")
			VAR Circumference = 2 * PI() * 80
			VAR Fill_Length = (Circumference*Donut_Fill)/100
			VAR Gap_Length = Circumference-Fill_Length
			VAR SVG_Data_URL = "data:image/svg+xml;utf8,"
			VAR SVG_Start = "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 250 250'>"
			VAR SVG_Data = 
			"
			<defs>
			    <linearGradient id='gradient' x1='0%' y1='0%' x2='100%' y2='0%'>
			        <stop offset='0%' style='stop-color: #f04393' />
			        <stop offset='100%' style='stop-color: #f9c449' />
			    </linearGradient>
			<style>
			    #backgroundCircle {
			        fill: none;
			        stroke: #f7f3f3;
			        stroke-width: 15;
			    }
			    #fillCircle {
			        fill: none;
			        stroke: url(#gradient);
			        stroke-width: 15;
			        stroke-dasharray: "& Fill_Length &" , "& Gap_Length &";
			        transform: rotate(-90deg);
			        transform-origin: center;
			        stroke-linecap: round;
			    }
			    #text {
			        font-family: Segoe UI;
			        font-size: 1.5em;
			        text-anchor: middle;
			        fill: #666;
			    }
			</style>
			</defs>
			
			<circle id='backgroundCircle' cx='125' cy='125' r='80' />
			<circle id='fillCircle' cx='125' cy='125' r='80' />
			<text id='text' x='100' y='100' dx='1.1em' dy='1.2em'> "& Donut_Text &" </text>
			"
			VAR SVG_End = "</svg>"
			RETURN
			SVG_Data_URL & SVG_Start & SVG_Data & SVG_End
			```
		displayFolder: Visual Measures
		lineageTag: 6341b07d-cbf3-431c-ad42-16ce43be889e
		dataCategory: ImageUrl

	measure 'Donut HTML Gradient 1' = ```
			
			VAR Donut_Fill = ([Total Sales]/CALCULATE([Total Sales],ALL(dModels[Model])))*100
			VAR Donut_Text = FORMAT(Donut_Fill/100,"#.0%")
			VAR Circumference = 2 * PI() * 80
			VAR Fill_Length = (Circumference*Donut_Fill)/100
			VAR Gap_Length = Circumference-Fill_Length
			VAR SVG_Data_URL = "data:image/svg+xml;utf8,"
			VAR SVG_Start = "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 250 250'>"
			VAR SVG_Data = 
			"
			<defs>
			    <linearGradient id='gradient' x1='0%' y1='0%' x2='100%' y2='0%'>
			        <stop offset='0%' style='stop-color: #f04393' />
			        <stop offset='100%' style='stop-color: #f9c449' />
			    </linearGradient>
			<style>
			    #backgroundCircle {
			        fill: none;
			        stroke: "/*#f7f3f3*/&"#333333;
			        stroke-width: 15;
			    }
			    #fillCircle {
			        fill: none;
			        stroke: url(#gradient);
			        stroke-width: 15;
			        stroke-dasharray: "& Fill_Length &" , "& Gap_Length &";
			        transform: rotate(-90deg);
			        transform-origin: center;
			        stroke-linecap: round;
			    }
			    #text {
			        font-family: Segoe UI;
			        font-size: 1.5em;
			        text-anchor: middle;
			        fill: #FFFFFF;
			    }
			</style>
			</defs>
			
			<circle id='backgroundCircle' cx='125' cy='125' r='80' />
			<circle id='fillCircle' cx='125' cy='125' r='80' />
			<text id='text' x='100' y='100' dx='1.1em' dy='1.2em'> "& Donut_Text &" </text>
			"
			VAR SVG_End = "</svg>"
			RETURN
			//SVG_Data_URL & SVG_Start & SVG_Data & SVG_End
			SVG_Start & SVG_Data & SVG_End
			```
		displayFolder: Visual Measures
		lineageTag: c24113cf-1892-4a8a-8818-1d99972a50c8

	measure 'Rectangular Gauge HTML' = ```
			
			VAR Gauge_Value = [YTD]  -- Replace with your actual measure
			VAR Max_Value = [LYTD]  -- Set your maximum value
			VAR Gauge_Percentage = (Gauge_Value / Max_Value) * 100
			VAR Gauge_Text = FORMAT(Gauge_Percentage / 100, "#.0%")
			VAR SVG_Data_URL = "data:image/svg+xml;utf8,"
			VAR SVG_Start = "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 300 100'>"
			VAR SVG_Data = 
			"
			<defs>
			    <linearGradient id='gradient' x1='0%' y1='0%' x2='100%' y2='0%'>
			        <stop offset='0%' style='stop-color: #f04393' />
			        <stop offset='100%' style='stop-color: #c4c4c4' />
			    </linearGradient>
			<style>
			    #backgroundRect {
			        fill: none;
			        stroke: #4e4e4e;
			        stroke-width: 15;
			    }
			    #fillRect {
			        fill: url(#gradient);
			        height: 30;
			        width: " & Gauge_Percentage & "%;
			    }
			    #text {
			        font-family: Segoe UI;
			        font-size: 1.5em;
			        text-anchor: Right;
			        fill: #192125;
			    }
			</style>
			</defs>
			
			<rect id='backgroundRect' x='25' y='60' width='290' height='30' />
			<rect id='fillRect' x='25' y='60' width='" & Gauge_Percentage & "%' height='30' />
			<text id='text' x='190' y='50'>" & Gauge_Text & "</text>
			"
			VAR SVG_End = "</svg>"
			RETURN
			SVG_Start & SVG_Data & SVG_End
			```
		displayFolder: Visual Measures
		lineageTag: d99a1c2a-5461-4b93-a7e3-010d80f777ec

	measure 'Semi Circular Gauge HTML' = ```
			VAR Gauge_Value = [YTD]  -- Replace with your actual measure
			VAR Max_Value = [LYTD]  -- Set your maximum value
			VAR Gauge_Percentage = (Gauge_Value / Max_Value) * 100
			VAR Gauge_Text = FORMAT(Gauge_Percentage / 100, "#.0%")
			VAR Angle = Gauge_Percentage * 1.8  -- Convert percentage to degrees (180 degrees for half circle)
			VAR SVG_Data_URL = "data:image/svg+xml;utf8,"
			VAR SVG_Start = "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 250 150'>"
			VAR SVG_Data = 
			"
			<defs>
			    <linearGradient id='gradient' x1='0%' y1='0%' x2='100%' y2='0%'>
			        <stop offset='0%' style='stop-color: #f04393' />
			        <stop offset='100%' style='stop-color: #f7f3f3' />
			    </linearGradient>
			<style>
			    #backgroundArc {
			        fill: none;
			        stroke: #f7f3f3;
			        stroke-width: 15;
			    }
			    #fillArc {
			        fill: none;
			        stroke: url(#gradient);
			        stroke-width: 15;
			        stroke-dasharray: " & Angle & ", 180;
			        transform: rotate(0deg);
			        transform-origin: center;
			        stroke-linecap: round;
			    }
			    #text {
			        font-family: Segoe UI;
			        font-size: 1.5em;
			        text-anchor: middle;
			        fill: #666;
			    }
			</style>
			</defs>
			
			<path id='backgroundArc' d='M 25 125 A 100 100 0 0 1 225 125' />
			<path id='fillArc' d='M 25 125 A 100 100 0 0 1 225 125' />
			<text id='text' x='125' y='100'>" & Gauge_Text & "</text>
			"
			VAR SVG_End = "</svg>"
			RETURN
			SVG_Start & SVG_Data & SVG_End
			```
		displayFolder: Visual Measures
		lineageTag: 316318c4-2149-4ff2-96e3-dfec0a0acbbb

