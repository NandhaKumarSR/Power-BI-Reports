	measure 'Forecast Date range' = CALCULATE(YEAR(Min(fUnitsSalesPredicted[Date]))) &" Q" &CALCULATE(QUARTER(Min(fUnitsSalesPredicted[Date])))& " - " & CALCULATE(YEAR(MAX(fUnitsSalesPredicted[Date]))) &" Q" &CALCULATE(QUARTER(MAX(fUnitsSalesPredicted[Date])))
		displayFolder: Titles
		lineageTag: 09f58d72-4322-4741-987b-5925ea3d1d39

