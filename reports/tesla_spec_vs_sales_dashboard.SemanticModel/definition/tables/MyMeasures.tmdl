	measure 'Min units sold' =
			
			VAR minvalue = MINX(ALLSELECTED(dDate),fUnitsSold[Units Sold])
			RETURN
			if(fUnitsSold[Units Sold] = minvalue, minvalue, blank()
			)
		formatString: 0
		lineageTag: 838906df-ff86-449a-a1fb-de743387d956

	measure 'Max units sold' =
			
			VAR maxvalue = MaxX(ALLSELECTED(dDate),fUnitsSold[Units Sold])
			RETURN
			if(fUnitsSold[Units Sold] = maxvalue, maxvalue, blank()
			)
		formatString: 0
		lineageTag: 0e0c0470-cca4-4c92-86b0-10d1e49c357f

	measure 'Min and Max Sales CF' = ```
			
			/*
			VAR maxvalue = MaxX(ALLSELECTED(dDate),CALCULATE(SUM(fSales[Sales Value])))
			VAR minvalue = MinX(ALLSELECTED(dDate),CALCULATE(SUM(fSales[Sales Value])))
			RETURN
			SWITCH(CALCULATE(SUM(fSales[Sales Value])), 
			maxvalue, 1,
			minvalue,2,
			0
			)
			*/
			
			VAR AverageSales = CALCULATE(AVERAGEX(ALLSELECTED(dDate[Date]),[Total Sales]))
			RETURN
			IF([Total Sales]>=AverageSales *1.5,1,if([Total Sales]<= AverageSales/1.5,2,3))
			```
		formatString: 0
		lineageTag: c197281b-4d47-43bb-ba3c-b29c3e9fa4f1

